    {
      "id": "prop4_n1_001",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce": "Qu'est-ce qu'un tableau de proportionnalité ?",
      "image": null,
      "choix": [
        "Un tableau où les nombres augmentent",
        "Un tableau où les valeurs de la ligne 2 s'obtiennent en multipliant celles de la ligne 1 par un même coefficient",
        "Un tableau avec des fractions",
        "Un tableau où les valeurs sont égales"
      ],
      "reponse": "Un tableau où les valeurs de la ligne 2 s'obtiennent en multipliant celles de la ligne 1 par un même coefficient",
      "explication": "Il y a proportionnalité quand toutes les valeurs de la 2e ligne = valeurs de la 1re ligne$\\times$même coefficient k."
    },
    {
      "id": "prop4_n1_002",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce": "Dans ce tableau, quel est le coefficient de proportionnalité ?",
      "image": "4eme/proportionnalite/15095c01a927be267a09aceb10d432f96d7d0618.png",
      "choix": [
        "0,5",
        "1,36",
        "2,72",
        "5,44"
      ],
      "reponse": "2,72",
      "explication": "1,36$\\div$0,5 = 2,72. Toutes les valeurs prix$\\div$masse = 2,72 = prix au kg."
    },
