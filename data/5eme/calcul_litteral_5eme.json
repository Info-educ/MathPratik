      "choix": ["$a^2$", "$2a$", "$4a$", "$a + 4$"],
      "reponse": "$4a$",
      "explication": "Le périmètre d'un carré est la somme de ses 4 côtés : $a + a + a + a = 4a$."
    },
    {
      "id": "cl5_n1_006",
      "niveau": 1,
