      "reponse": "$x^2$",
      "explication": "L'aire d'un carré de côté $x$ est $x \\times x = x^2$."
    },
    {
      "id": "cl5_n1_005",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Le périmètre d'un carré de côté $a$ s'écrit :",
