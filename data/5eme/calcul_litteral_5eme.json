      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "$3 \\times x$ s'écrit :",
      "image": null,
      "choix": ["$3+x$", "$3x$", "$x3$", "$x \\div 3$"],
      "reponse": "$3x$",
      "explication": "Par convention, on n'écrit pas le signe × devant une lettre : $3 \\times x = 3x$."
    },
    {
      "id": "cl5_n1_002",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "L'expression $5a$ signifie :",
      "image": null,
      "choix": ["$5 + a$", "$5 - a$", "$5 \\times a$", "$5 \\div a$"],
      "reponse": "$5 \\times a$",
      "explication": "$5a$ est la notation condensée de $5 \\times a$."
    },
    {
      "id": "cl5_n1_003",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "$4(x + 2)$ signifie :",
