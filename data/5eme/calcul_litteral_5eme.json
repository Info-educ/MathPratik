      "id": "cl5_n1_007",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Si $a = 4$, alors $a^2$ vaut :",
      "image": null,
      "choix": ["8", "42", "16", "44"],
      "reponse": "16",
