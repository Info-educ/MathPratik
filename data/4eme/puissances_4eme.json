  "questions": [
    {
      "id": "pu4_n1_001",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Que signifie $a^n$ ?",
      "image": null,
      "choix": ["$a$ multiplié par $n$", "Le produit de $n$ facteurs égaux à $a$", "$a$ divisé par $n$", "$a + n$"],
      "reponse": "Le produit de $n$ facteurs égaux à $a$",
      "explication": "$a^n = a \\times a \\times \\ldots \\times a$ ($n$ fois). C'est le produit de $n$ facteurs égaux à $a$."
    },
    {
      "id": "pu4_n1_002",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $2^5$.",
      "image": null,
      "choix": ["$10$", "$25$", "$32$", "$64$"],
      "reponse": "$32$",
      "explication": "$2^5 = 2 \\times 2 \\times 2 \\times 2 \\times 2 = 32$."
    },
    {
      "id": "pu4_n1_003",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $(-3)^4$.",
      "image": null,
      "choix": ["$-81$", "$81$", "$-12$", "$12$"],
      "reponse": "$81$",
      "explication": "$(-3)^4 = (-3)\\times(-3)\\times(-3)\\times(-3) = 81$. L'exposant est pair donc le résultat est positif."
    },
    {
      "id": "pu4_n1_004",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $(-2)^3$.",
      "image": null,
      "choix": ["$8$", "$-8$", "$6$", "$-6$"],
      "reponse": "$-8$",
      "explication": "$(-2)^3 = (-2)\\times(-2)\\times(-2) = -8$. L'exposant est impair donc le résultat est négatif."
    },
    {
      "id": "pu4_n1_005",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Que vaut $a^1$ ?",
      "image": null,
      "choix": ["$0$", "$1$", "$a$", "$a^2$"],
      "reponse": "$a$",
      "explication": "$a^1 = a$. Tout nombre à la puissance 1 est lui-même."
    },
    {
      "id": "pu4_n1_006",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Que vaut $a^0$ pour $a \\neq 0$ ?",
      "image": null,
      "choix": ["$0$", "$1$", "$a$", "Indéfini"],
      "reponse": "$1$",
      "explication": "Pour tout $a \\neq 0$, $a^0 = 1$. C'est une convention fondamentale des puissances."
    },
    {
      "id": "pu4_n1_007",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $5^0$.",
      "image": null,
      "choix": ["$0$", "$1$", "$5$", "$25$"],
      "reponse": "$1$",
      "explication": "$5^0 = 1$. Tout nombre non nul à la puissance 0 vaut 1."
    },
    {
      "id": "pu4_n1_008",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $1^{100}$.",
      "image": null,
      "choix": ["$0$", "$1$", "$100$", "$1^{100}$"],
      "reponse": "$1$",
      "explication": "$1^{100} = 1$. Le nombre 1 multiplié par lui-même reste toujours 1."
    },
    {
      "id": "pu4_n1_009",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $(-1)^7$.",
      "image": null,
      "choix": ["$1$", "$-1$", "$7$", "$-7$"],
      "reponse": "$-1$",
      "explication": "$(-1)^7 = -1$. L'exposant 7 est impair, donc le résultat est négatif."
    },
    {
      "id": "pu4_n1_010",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $(-1)^8$.",
      "image": null,
      "choix": ["$1$", "$-1$", "$8$", "$-8$"],
      "reponse": "$1$",
      "explication": "$(-1)^8 = 1$. L'exposant 8 est pair, donc le résultat est positif."
    },
    {
      "id": "pu4_n1_011",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Quelle est la règle de signe pour $(-a)^n$ ?",
      "image": null,
      "choix": ["Toujours positif", "Toujours négatif", "Positif si $n$ pair, négatif si $n$ impair", "Dépend de la valeur de $a$"],
      "reponse": "Positif si $n$ pair, négatif si $n$ impair",
      "explication": "Si $n$ est pair, $(-a)^n > 0$. Si $n$ est impair, $(-a)^n < 0$."
    },
    {
      "id": "pu4_n1_012",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Dans l'ordre des priorités, les puissances s'effectuent :",
      "image": null,
      "choix": ["Après les multiplications", "Avant les multiplications et divisions", "En même temps que les additions", "En dernier"],
      "reponse": "Avant les multiplications et divisions",
      "explication": "Ordre des priorités : parenthèses → puissances → $\\times$ et $\\div$ → $+$ et $-$."
    },
    {
      "id": "pu4_n1_013",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $A = 1 + 3 \\times 2^3$.",
      "image": null,
      "choix": ["$32$", "$25$", "$48$", "$49$"],
      "reponse": "$25$",
      "explication": "Puissance d'abord : $2^3=8$. Puis multiplication : $3\\times 8=24$. Puis addition : $1+24=25$."
    },
    {
      "id": "pu4_n1_014",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Calcule $B = 2 + 5^2 - 3$.",
      "image": null,
      "choix": ["$20$", "$24$", "$26$", "$46$"],
      "reponse": "$24$",
      "explication": "$5^2=25$. $B = 2+25-3 = 24$."
