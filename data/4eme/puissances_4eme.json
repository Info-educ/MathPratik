      "explication": "$5 \\times 10^4 = 5 \\times 10\\,000 = 50\\,000$."
    },
    {
      "id": "pu4_n1_022",
      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce_html": "Que signifie $a^{-n}$ ?",
