      "image": null,
      "choix": ["$14$", "$25$", "$32$", "$64$"],
      "reponse": "$32$",
      "explication": "Parenthèses d'abord : $1+3=4$. Puissance : $2^3=8$. Puis : $4\\times 8=32$."
