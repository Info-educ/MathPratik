      "niveau": 1,
      "type": "qcm",
      "avec_calculatrice": false,
      "enonce": "Qu'est-ce qu'un tableau de proportionnalité ?",
      "image": null,
      "choix": [
        "Un tableau où les nombres augmentent",
        "Un tableau où les valeurs de la ligne 2 s'obtiennent en multipliant celles de la ligne 1 par un même coefficient",
